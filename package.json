{
  "name": "thutovest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ThutoVest: student pathway, funding-gap and sponsor marketplace (frontend prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=high",
    "build:server": "vite build --config vite.server.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
